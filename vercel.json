{
  "redirects": [
    {
      "source": "/crest",
      "destination": "/crest.html",
      "permanent": false
    },
    {
      "source": "/studio",
      "destination": "/crest.html",
      "permanent": false
    },
    {
      "source": "/qr/campus",
      "destination": "/crest.html?utm_source=masters_union&utm_medium=qr&utm_campaign=campus_poster",
      "permanent": false
    },
    {
      "source": "/qr/class",
      "destination": "/crest.html?utm_source=masters_union&utm_medium=qr&utm_campaign=class_screen",
      "permanent": false
    },
    {
      "source": "/qr/card",
      "destination": "/crest.html?utm_source=business_card&utm_medium=qr&utm_campaign=card",
      "permanent": false
    },
    {
      "source": "/qr/sticker",
      "destination": "/crest.html?utm_source=sticker&utm_medium=qr&utm_campaign=sticker",
      "permanent": false
    },
    {
      "source": "/qr/games",
      "destination": "/games/?utm_source=games_poster&utm_medium=qr&utm_campaign=games_poster",
      "permanent": false
    },
    {
      "source": "/qr/gift",
      "destination": "/family-crest-gift.html?utm_source=gift_flyer&utm_medium=qr&utm_campaign=gift",
      "permanent": false
    },
    {
      "source": "/qr",
      "destination": "/crest.html?utm_source=qr&utm_medium=qr&utm_campaign=general",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/c/:code",
      "destination": "/api/share?d=:code"
    },
    {
      "source": "/card/:code",
      "destination": "/api/card?d=:code"
    }
  ],
  "functions": {
    "api/og.js": {
      "includeFiles": "api/fonts/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/((?!embed/).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/embed/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "object-src 'none'; base-uri 'self'"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/games/(.+\\.js|.+\\.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Content-Type",
          "value": "text/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
