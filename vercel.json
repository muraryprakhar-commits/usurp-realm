{
  "redirects": [
    {
      "source": "/crest",
      "destination": "/crest.html",
      "permanent": false
    },
    {
      "source": "/studio",
      "destination": "/crest.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/c/:code",
      "destination": "/api/share?d=:code"
    },
    {
      "source": "/card/:code",
      "destination": "/api/card?d=:code"
    }
  ],
  "functions": {
    "api/og.js": {
      "includeFiles": "api/fonts/**"
    }
  },
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/games/(.+\\.js|.+\\.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
